# What kernel/test/fsck.sh is given to repair, applied by run-fsck.sh with `b6fsutil -D'.
# One spec per line; the inode numbers are fsck.manifest's order, and run-fsck.sh refuses
# to boot if `b6fsutil -c' cannot find the damage, so a spec that drifts fails loudly.
#
# TWO KINDS OF DAMAGE, CHOSEN FOR WHAT THEY MAKE THE GUEST *WRITE*, since that is the half
# cmd/fsck/test cannot reach:
#
#   an orphan, which makes fsck write a directory block, two inodes and a directory's size
#   -- scattered small writes through physio() and mdwrite();
#
#   and a free-list count fsck cannot believe, which makes it rebuild the whole free list
#   of a 2000-block volume in phase 6 -- about six chain blocks spread across the pack,
#   which is the largest sustained sequence of raw writes anything on this system does.

# Drop /d/e/f (entry 2 of /d/e, inode 5).  The file survives with nothing pointing at it,
# so phase 4 reconnects it into /lost+found under its i-number.
e5.2=0

# A free-list count outside 1..NICFREE.  freechk() refuses it, phase 5 declares BAD FREE
# LIST and phase 6 lays the whole list down again.
sb.nfree=999
