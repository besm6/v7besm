# The root filesystem the kernel mounts -- what `b6fsutil -n -M' builds into root.img,
# which `-S' then converts into the SIMH container test/CMakeLists.txt attaches as md00.
# Grammar: cmd/fsutil/README.md.
#
# The tree, the device nodes, and the USERLAND -- /bin/sh and the four commands that prove
# the prompt, plus the static files of /etc.  Task 24 put them here.
#
# /etc/init IS STILL kernel/test/coninit.S, THE TASK-23 STAND-IN, and task 24's last step --
# naming build/rootfs/etc/init instead -- is not taken here.  The reason is no longer the
# kernel: task 25a fixed the kernel stack (UBASE moved down a page to 074000, so the stack
# has 1908 words instead of 880 and the 15-bit wrap at 0100000 is out of reach), and a
# throwaway run with `source ../../rootfs/etc/init' in this slot boots to the shell's root
# prompt and runs `ls /bin'.  What is left is task 25b's work, which is HERE and next door
# rather than in the kernel: flipping this line means rewriting kernel/test/console's whole
# dialogue, which asserts on coninit's `line> ' prompt and its echo, and the disk is
# attached -r so nothing can be written yet.  They change together or not at all.
#
# For the record, the measurement that made 25a necessary -- by sampling a local's address
# in clock() and reading the maximum back out of memory, which is a tick-sampled LOWER
# bound on the true peak:
#
#     coninit as /etc/init      max SP 077510   184 words of headroom
#     the real init + a stub sh max SP 077531   167 words
#     /bin/sh as process 1      max SP 077623   109 words
#
# The deep points are ordinary code (uptget, getblk, mdstrategy), so it was not a runaway
# recursion; the port simply used ~790 of the ~880 words the one u-area page left for a
# stack, and one nested interrupt frame on top of that was enough.  Booting the real init
# failed with `panic: kernel trap' and r15 = 0 or 010 in the dump.  Watchpoints under SIMH
# have since put the true peak at 076100-076177 -- 948-1011 words -- which is why 880 could
# not work.  kernel/TODO.md task 25a has the whole account.
#
# coninit is built next door either way: it is the one user program on this system that
# links neither crt0 nor libc, so it is what a console failure gets bisected against.
#
# EVERY `source' NAMES build/rootfs/, and by a relative path, because b6fsutil resolves one
# against its own working directory -- the kernel test BUILD directory, which
# kernel/test/CMakeLists.txt sets.  From build/kernel/test/, `../../rootfs' is
# build/rootfs/, and that holds for any build directory, since both ends are under
# CMAKE_BINARY_DIR.  build/rootfs/ is staged by b6_prog() (scripts/BesmCross.cmake) for the
# programs and by etc/CMakeLists.txt for the text files; the top-level CMakeLists.txt draws
# the `rootimg depends on rootfs' edge, since kernel/ is configured before rootfs exists.
#
# CONSEQUENCE: this manifest is now dependent on the top-level project.  A standalone
# `cmake -S kernel' can still build and boot the kernel, but it cannot build root.img,
# because nothing there stages a build/rootfs/ for these paths to point at.
#
# Two tests read this image: kernel/test/fstest, which checks the superblock and the root
# inode below the boot path, and kernel/test/boot + kernel/test/console, which boot a
# kernel against it.
#
# THE DEVICE NUMBERS ARE kernel/conf.c's, and that file is the authority: the major is the
# row index in bdevsw[] (0 md, 1 mb) or cdevsw[] (0 console, 1 mem, 2 tty, 3 sr, 4 rmd,
# 5 rmb).  A node here that names a row conf.c does not have opens onto nothing.
#
# For the disk, the MINOR IS THE SIMULATOR'S UNIT SUBSCRIPT -- bit 5 the controller, bits
# 4-3 the group (линейка), bits 2-0 the drive -- so /dev/md0's minor 0 is SIMH's md00, and
# a minor number and an `attach' line are the same number.  There are no partitions: one
# EC-5052 drive is 2000 blocks and swap lives on the drums (/dev/swap, block major 1).

default
owner 0
group 0
dirmode 0755
filemode 0644

dir /bin
dir /dev
dir /etc
dir /usr

dir /tmp
mode 0777

# ---- the program the icode execs, and the shell it will exec in turn -------------
#
# `source coninit' is a bare filename because it is resolved against b6fsutil's working
# directory, the kernel test BUILD directory, which is where coninit is linked.  Task 25b
# makes this `source ../../rootfs/etc/init', and kernel/test/console changes with it.

file /etc/init          # kernel/test/coninit.S -- the task-23 stand-in; see the header
source coninit
mode 0755

file /bin/sh            # cmd/sh: S. R. Bourne's shell
source ../../rootfs/bin/sh
mode 0755

# ---- enough commands to prove the prompt -----------------------------------------

file /bin/cat           # cmd/cat -- and what /etc/rc uses to print the motd
source ../../rootfs/bin/cat
mode 0755

file /bin/echo          # cmd/echo
source ../../rootfs/bin/echo
mode 0755

file /bin/ls            # cmd/ls
source ../../rootfs/bin/ls
mode 0755

file /bin/pwd           # cmd/pwd
source ../../rootfs/bin/pwd
mode 0755

# ---- the static files of /etc ----------------------------------------------------
#
# /etc/rc is 0644, NOT 0755: runcom() in cmd/init/init.c execs `sh /etc/rc', never the
# script itself.  There is no `#!' on this system -- the shebang is a 4.xBSD invention, and
# neither getxfile() nor b6sim implements it -- so a script is never executed directly;
# either the shell is told to read it, or exec comes back ENOEXEC and the shell reads it
# anyway (cmd/sh/README.md).

file /etc/rc            # the boot script; etc/rc
source ../../rootfs/etc/rc
mode 0644

file /etc/motd          # the message of the day, printed by /etc/rc; etc/motd
source ../../rootfs/etc/motd
mode 0644

file /etc/passwd        # v7's, read by `ls -l' to turn a uid into a name; etc/passwd
source ../../rootfs/etc/passwd
mode 0644

# ---- character devices ----------------------------------------------------------

cdev /dev/console       # cdevsw[0]: the operator's console, dev/sc.c
major 0
minor 0
mode 0622

cdev /dev/mem           # cdevsw[1] minor 0: physical memory, dev/mem.c
major 1
minor 0
mode 0640

cdev /dev/kmem          # cdevsw[1] minor 1: kernel virtual memory
major 1
minor 1
mode 0640

cdev /dev/null          # cdevsw[1] minor 2: the bit bucket
major 1
minor 2
mode 0666

cdev /dev/tty           # cdevsw[2]: the controlling terminal, dev/sys.c
major 2
minor 0
mode 0666

cdev /dev/rmd0          # cdevsw[4]: the raw disk, dev/md.c
major 4
minor 0
mode 0600

cdev /dev/rmb0          # cdevsw[5]: the raw drum, dev/mb.c
major 5
minor 0
mode 0600

# ---- block devices --------------------------------------------------------------

bdev /dev/md0           # bdevsw[0]: the root disk -- rootdev = makedev(0, 0)
major 0
minor 0
mode 0600

bdev /dev/swap          # bdevsw[1]: the drums -- swapdev = makedev(1, 0)
major 1
minor 0
mode 0600
