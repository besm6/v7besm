export a
readonly assigned
export b
export a
readonly assigned
export b
0022
IFS= 	

a=one
aftershift=beta
alsonosuch=stored
argc=3
argv0=./smoke.sh
assigned=stored
b=two
branch=then
defaulted=fallback
double=cooked one
escaped=$a
first=alpha
i=r
ifprobe=taken
