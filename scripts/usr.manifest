# The /usr pack: what `b6fsutil -n -M' builds into usr.img and `-S' converts into
# usr3100.disk, attached as md01.  Grammar: cmd/fsutil/README.md.
#
# THE PACK'S ROOT IS WHAT APPEARS AT /usr, so every path here is one component shorter
# than the path it has on the running machine: /bin/cpp below is /usr/bin/cpp once
# mounted.  Comments still name the mounted path.
#
# /etc/rc fscks it and mounts it read-write on /dev/md1, before `date'.  Read-write
# because /spool/at and /spool/mail are written at run time; kernel/test/multi therefore
# converts a writable copy of its own, as it already does for the root.
#
# `source' resolves against b6fsutil's working directory, build/kernel/test, so
# ../../rootfs/usr is the ROOT's staging tree -- shared, unlike the test pack's.
#
# The dependency list is USRFS_FILES in kernel/test/CMakeLists.txt, and for /include and
# /man the B6_STAGE_INC / B6_STAGE_FREEINC / B6_STAGE_MAN lists in the top-level
# CMakeLists.txt.  Adding a file means editing both.

default
owner 0
group 0
dirmode 0755
filemode 0644

dir /lost+found         # fsck reconnects here; it cannot create the directory itself

dir /bin
dir /include
dir /include/sys
dir /lib
dir /lib/calendars
dir /dict
dir /man
dir /man/man1
dir /man/man2
dir /man/man3
dir /man/man5
dir /man/man8
dir /spool
dir /spool/at
mode 0777
dir /spool/at/past
mode 0777
dir /spool/mail

# ---- /usr/bin -- the toolchain ---------------------------------------------------

file /bin/cpp           # C preprocessor
source ../../rootfs/usr/bin/cpp
mode 0755

file /bin/as            # assembler
source ../../rootfs/usr/bin/as
mode 0755

file /bin/ld            # link editor
source ../../rootfs/usr/bin/ld
mode 0755

file /bin/nm            # print name list
source ../../rootfs/usr/bin/nm
mode 0755

file /bin/size          # size of an object file
source ../../rootfs/usr/bin/size
mode 0755

file /bin/strip         # remove symbols from an object file
source ../../rootfs/usr/bin/strip
mode 0755

file /bin/disasm        # disassembler
source ../../rootfs/usr/bin/disasm
mode 0755

file /bin/lorder        # find ordering relation for an object library
source ../../rootfs/usr/bin/lorder
mode 0755

file /bin/ar            # archive and library maintainer
source ../../rootfs/usr/bin/ar
mode 0755

file /bin/ranlib        # convert archives to random libraries
source ../../rootfs/usr/bin/ranlib
mode 0755

file /bin/cc            # C compiler driver; cannot compile C on this machine
source ../../rootfs/usr/bin/cc
mode 0755

file /bin/yacc          # yet another compiler-compiler
source ../../rootfs/usr/bin/yacc
mode 0755

file /bin/lex           # generator of lexical analysis programs
source ../../rootfs/usr/bin/lex
mode 0755

file /bin/man           # print out the manual
source ../../rootfs/usr/bin/man
mode 0755

file /bin/manview       # format a manual page
source ../../rootfs/usr/bin/manview
mode 0755

file /bin/calendar      # reminder service
source ../../rootfs/usr/bin/calendar
mode 0755

