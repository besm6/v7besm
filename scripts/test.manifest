# The test pack: what `b6fsutil -n -M' builds into test.img and `-S' converts into
# test3077.disk, attached read-only as md07.  Grammar: cmd/fsutil/README.md.
#
# The lib/test programs, as /test/*.  Nothing mounts it: whoever wants it types
# `/etc/mount /dev/md7 /mnt -r' and reads them as /mnt/test/*.  Read-only, so one copy
# serves every test.
#
# `source' resolves against b6fsutil's working directory, build/kernel/test, so
# ../../testfs is lib/test's own staging tree.
#
# The list is also in lib/test/progs.cmake; adding a program means editing both.

default
owner 0
group 0
dirmode 0755
filemode 0644

dir /lost+found         # mkfs makes one and so does this; nothing fscks this pack

dir /test
dir /test/scratch       # dirt's workspace, and the only directory here meant to stay empty

file /test/hello
source ../../testfs/test/hello
mode 0755

file /test/vararg
source ../../testfs/test/vararg
mode 0755

file /test/errno
source ../../testfs/test/errno
mode 0755

file /test/procs
source ../../testfs/test/procs
mode 0755

file /test/sbrkt
source ../../testfs/test/sbrkt
mode 0755

file /test/malloct
source ../../testfs/test/malloct
mode 0755

file /test/strings
source ../../testfs/test/strings
mode 0755

file /test/gen
source ../../testfs/test/gen
mode 0755

file /test/strtolt
source ../../testfs/test/strtolt
mode 0755

file /test/environ
source ../../testfs/test/environ
mode 0755

file /test/jmp
source ../../testfs/test/jmp
mode 0755

file /test/headers
source ../../testfs/test/headers
mode 0755

file /test/stdiot
source ../../testfs/test/stdiot
mode 0755

file /test/printft
source ../../testfs/test/printft
mode 0755

file /test/scanft
source ../../testfs/test/scanft
mode 0755

file /test/execs
source ../../testfs/test/execs
mode 0755

file /test/shellt
source ../../testfs/test/shellt
mode 0755

