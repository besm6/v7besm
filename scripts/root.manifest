source ../../rootfs/etc/termcap
mode 0644

# ---- /lib -- what cc links against -----------------------------------------------

file /lib/crt0.o        # startup object, named on the link line
source ../../rootfs/lib/crt0.o
mode 0644

file /lib/libc.a        # the C library
source ../../rootfs/lib/libc.a
mode 0644

file /lib/libruntime.a  # the external c-compiler's b$* helpers
source ../../rootfs/lib/libruntime.a
mode 0644

# ---- character devices -----------------------------------------------------------
#
# Major numbers are the row index in cdevsw[] / bdevsw[]; kernel/conf.c is the authority.
# A disk minor is a flat drive index, identical to the simulator's unit subscript, so
# /dev/md1 is SIMH's md01.

cdev /dev/console       # cdevsw[0] minor 0: the operator's Consul, dev/sc.c
major 0
minor 0
mode 0622

cdev /dev/tty0          # the same device, under the name /etc/ttys uses; a separate inode
major 0
minor 0
mode 0622

cdev /dev/tty1          # cdevsw[0] minor 1: the second Consul
major 0
minor 1
mode 0622

cdev /dev/mem           # cdevsw[1] minor 0: physical memory, dev/mem.c
major 1
minor 0
mode 0640

cdev /dev/kmem          # cdevsw[1] minor 1: kernel virtual memory
major 1
minor 1
mode 0640

cdev /dev/null          # cdevsw[1] minor 2: the bit bucket
major 1
minor 2
mode 0666

cdev /dev/tty           # cdevsw[2]: the controlling terminal, dev/sys.c
major 2
minor 0
mode 0666

cdev /dev/rmd0          # cdevsw[3] minor 0: the raw root disk, dev/md.c
major 3
minor 0
mode 0600

cdev /dev/rmd1          # cdevsw[3] minor 1: the raw /usr pack -- what /etc/rc fscks
major 3
minor 1
mode 0600

cdev /dev/rmd2          # cdevsw[3] minor 2: reserved for /tmp
major 3
minor 2
mode 0600

cdev /dev/rmd3          # cdevsw[3] minor 3: reserved for /home
major 3
minor 3
mode 0600

cdev /dev/rmd4          # cdevsw[3] minor 4: unassigned
major 3
minor 4
mode 0600

cdev /dev/rmd5          # cdevsw[3] minor 5: unassigned
major 3
minor 5
mode 0600

cdev /dev/rmd6          # cdevsw[3] minor 6: unassigned
major 3
minor 6
mode 0600

cdev /dev/rmd7          # cdevsw[3] minor 7: the test pack
major 3
minor 7
mode 0600

cdev /dev/rmb0          # cdevsw[4]: the raw drum, dev/mb.c
major 4
minor 0
mode 0600

# ---- block devices ---------------------------------------------------------------
#
# Eight drives since NMOUNT went from 2 to 8, and every one has a raw twin above:
# without the nodes to name them that is capacity nothing can reach, and mknod on a
# running system does not survive the image being rebuilt.

bdev /dev/md0           # bdevsw[0] minor 0: the root -- rootdev = makedev(0, 0)
major 0
minor 0
mode 0600

bdev /dev/md1           # bdevsw[0] minor 1: /usr, mounted by /etc/rc
major 0
minor 1
mode 0600

bdev /dev/md2           # bdevsw[0] minor 2: reserved for /tmp
major 0
minor 2
mode 0600

bdev /dev/md3           # bdevsw[0] minor 3: reserved for /home
major 0
minor 3
mode 0600

bdev /dev/md4           # bdevsw[0] minor 4: unassigned
major 0
minor 4
mode 0600

bdev /dev/md5           # bdevsw[0] minor 5: unassigned
major 0
minor 5
mode 0600

bdev /dev/md6           # bdevsw[0] minor 6: unassigned
major 0
minor 6
mode 0600

bdev /dev/md7           # bdevsw[0] minor 7: the test pack, mounted by hand on /mnt
major 0
minor 7
mode 0600

bdev /dev/swap          # bdevsw[1]: the drums -- swapdev = makedev(1, 0)
major 1
minor 0
mode 0600
