# The root filesystem: what `b6fsutil -n -M' builds into root.img and `-S' converts into
# root3072.disk, attached as md00.  Grammar: cmd/fsutil/README.md.
#
# `source' resolves against b6fsutil's working directory, build/kernel/test, so
# ../../rootfs is the staging tree cmd/ and etc/ fill.
#
# /usr is a MOUNT POINT, not a directory: its contents are on a pack of their own
# (scripts/usr.manifest), which /etc/rc fscks and mounts on /dev/md1.
#
# The dependency list is ROOTFS_FILES in kernel/test/CMakeLists.txt; adding a file means
# editing both.

default
owner 0
group 0
dirmode 0755
filemode 0644

dir /bin
dir /dev
dir /etc
dir /usr                # mount point; the pack is scripts/usr.manifest
dir /lib
dir /tmp
mode 0777
dir /lost+found
dir /mnt
dir /home
dir /home/guest
owner 7
group 3

# ---- /home -----------------------------------------------------------------------

file /home/guest/hello.S # cc(1) demo source, the only source file on this disk
source ../../rootfs/home/guest/hello.S
mode 0644
owner 7
group 3

# ---- /etc -- the programs --------------------------------------------------------

file /etc/init          # process control initialization
source ../../rootfs/etc/init
mode 0755

file /etc/getty         # set typewriter mode and read a login name
source ../../rootfs/etc/getty
mode 0755

file /etc/quot          # summarize file system ownership
source ../../rootfs/etc/quot
mode 0755

file /etc/mkfs          # construct a file system
source ../../rootfs/etc/mkfs
mode 0755

file /etc/fsck          # file system consistency check and interactive repair
source ../../rootfs/etc/fsck
mode 0755

file /etc/clri          # clear i-node
source ../../rootfs/etc/clri
mode 0755

file /etc/dcheck        # file system directory consistency check
source ../../rootfs/etc/dcheck
mode 0755

file /etc/icheck        # file system storage consistency check
source ../../rootfs/etc/icheck
mode 0755

file /etc/ncheck        # generate names from i-numbers
source ../../rootfs/etc/ncheck
mode 0755

file /etc/iostat        # report I/O statistics
source ../../rootfs/etc/iostat
mode 0755

file /etc/pstat         # print system facts
source ../../rootfs/etc/pstat
mode 0755

file /etc/mount         # mount and dismount file system
source ../../rootfs/etc/mount
mode 0755

file /etc/umount        # dismount a file system
source ../../rootfs/etc/umount
mode 0755

file /etc/wall          # write to all users
source ../../rootfs/etc/wall
mode 0755

file /etc/update        # periodically update the super block
source ../../rootfs/etc/update
mode 0755

file /etc/cron          # clock daemon
source ../../rootfs/etc/cron
mode 0755

