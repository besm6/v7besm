# ---- /etc -- the static files ----------------------------------------------------

file /etc/rc            # the boot script
source ../../rootfs/etc/rc
mode 0644

file /etc/motd          # message of the day
source ../../rootfs/etc/motd
mode 0644

file /etc/passwd        # change login password
source ../../rootfs/etc/passwd
mode 0644

file /etc/group         # group file
source ../../rootfs/etc/group
mode 0644

file /etc/ttys          # terminal initialization data
source ../../rootfs/etc/ttys
mode 0644

